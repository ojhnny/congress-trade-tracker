# Copy this file to .env and fill in the blanks. .env is gitignored.

# --- Pipeline settings (read by src/congress_trades/config.py) ---
GCP_PROJECT_ID=
# Bucket names are global across all of Google Cloud, so prefix with your project id.
GCS_RAW_BUCKET=
# Must include a contact email. SEC EDGAR blocks requests without one.
HTTP_USER_AGENT=congress-trades research you@example.com
BQ_LOCATION=US
BQ_RAW_DATASET=raw

# --- Local Airflow ---
# Linux only: set to the output of `id -u` so log files are owned by you.
AIRFLOW_UID=50000
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=
